<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="synaxis.json" />
        <include domain="sharedpref" path="synaxis_prefs.xml" />
        <exclude domain="file" path="docs/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="synaxis.json" />
        <include domain="sharedpref" path="synaxis_prefs.xml" />
    </device-transfer>
</data-extraction-rules>