<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Back up the library: bookmarks, recents, highlights, settings. -->
    <include domain="file" path="." />
    <include domain="sharedpref" path="." />

    <!-- But not the downloaded lives; they can always be fetched again. -->
    <exclude domain="file" path="docs" />
</full-backup-content>