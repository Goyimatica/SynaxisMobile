<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Back up the library: bookmarks, recents, highlights, settings. -->
    <include domain="file" path="." />
    <include domain="sharedpref" path="." />

    <!-- But not the downloaded lives or their icons; both can always be
         fetched again, and both are now permanent on the device (V10). -->
    <exclude domain="file" path="docs" />
    <exclude domain="file" path="icons" />
</full-backup-content>
